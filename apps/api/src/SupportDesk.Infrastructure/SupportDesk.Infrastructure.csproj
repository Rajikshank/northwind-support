<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Implements the domain's repositories and the application's abstractions with EF Core and
    SQL Server: the DbContext, mappings, migrations and seed data (Data/), repositories, read
    queries and the system clock.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../SupportDesk.Application/SupportDesk.Application.csproj" />
    <ProjectReference Include="../SupportDesk.Domain/SupportDesk.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- EF CLI tooling is needed locally, not for a container restore/publish. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Condition="'$(ContainerBuild)' != 'true'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
